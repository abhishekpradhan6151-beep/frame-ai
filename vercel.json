{
  "framework": "vite",
  "functions": {
    "api/*.ts": {
      "includeFiles": "{api/_lib/**,node_modules/@google/genai/**,frame-ai.zip,public/frame-ai.zip}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
